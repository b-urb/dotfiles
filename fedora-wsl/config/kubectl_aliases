# Small, auditable subset inspired by ahmetb/kubectl-aliases (Apache-2.0).
alias k='kubectl'
alias ka='kubectl apply -f'
alias kak='kubectl apply -k'
alias kd='kubectl describe'
alias kdel='kubectl delete'
alias kex='kubectl exec -it'
alias klo='kubectl logs'
alias klof='kubectl logs -f'
alias kpf='kubectl port-forward'
alias kg='kubectl get'
alias kgall='kubectl get --all-namespaces'
alias kgcm='kubectl get configmaps'
alias kgdep='kubectl get deployments'
alias kging='kubectl get ingresses'
alias kgn='kubectl get --namespace'
alias kgno='kubectl get nodes'
alias kgns='kubectl get namespaces'
alias kgpo='kubectl get pods'
alias kgpoa='kubectl get pods --all-namespaces'
alias kgpow='kubectl get pods --watch'
alias kgsec='kubectl get secrets'
alias kgsts='kubectl get statefulsets'
alias kgsvc='kubectl get services'
alias ksys='kubectl --namespace=kube-system'
alias ksysgpo='kubectl --namespace=kube-system get pods'
