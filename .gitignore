# Generated files with secrets (DO NOT COMMIT)
config/codex/config.toml
gitconfig
bashrc
.env
.env.darwin
.env.linux
config/opencode/opencode.jsonc

# Local dotfiles options overrides
options/dotfiles.options.local.sh

# Kubernetes configs (backed up to Bitwarden)
kube/*
!kube/*/
kube/clusters/*
!kube/clusters/.gitkeep
!kube/clusters/*.sh
config/k9s/clusters/

# SSH keys (backed up to Bitwarden)
ssh/*
!ssh/.gitkeep

# Keep .checksums tracked (used for sync optimization)
!.checksums

# Keep templates tracked
!templates/*.tmpl

install

# Other
sync.yaml
zshrc
gradle.properties
ubuntu/keyring.deb
/dot_config/vscode/User/History
/dot_config/vscode/User/globalStorage
/dot_config/vscode/User/workspaceStorage

# APM: `just agents-sync` runs with HOME at the repo root; only the lockfile is kept
/.apm/*
/.claude
/.codex
/.agents
/.cache/
/.local/
/Library/Caches/apm/
# private skills from b-urb/agent-config, b-urb/homelab and b-urb/design-system, generated by just agents-sync
/dot_claude/skills/agent-secrets/
/dot_claude/skills/blender-projects/
/dot_claude/skills/homelab/
/dot_claude/skills/homelab-ui/
/dot_claude/skills/outline/
/dot_claude/skills/vikunja/
/agents/skills/agent-secrets/
/agents/skills/blender-projects/
/agents/skills/homelab/
/agents/skills/homelab-ui/
/agents/skills/outline/
/agents/skills/vikunja/
/.apm/apm.lock.yaml
