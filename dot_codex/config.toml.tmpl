experimental_use_rmcp_client = true
sandbox_mode = "workspace-write"
network_access = "enabled"
approval_policy = "on-failure"
allow_shell = true
model_reasoning_effort = "high"

[features]
hooks = true
rmcp_client = true
web_search_request = true

[projects."/Users/bjornurban/code/work/freelance/bahrenberg/website-v2"]
trust_level = "trusted"


[shell_environment_policy]
set = { HOMELAB_AGENT = "codex", KUBECONFIG = "{{ .chezmoi.homeDir }}/.kube/homelab-view.yaml", GH_CONFIG_DIR = "{{ .chezmoi.homeDir }}/.config/homelab/agents/gh", BAO_CONFIG_PATH = "{{ .chezmoi.homeDir }}/code/homelab/.claude/bao.hcl", GIT_TERMINAL_PROMPT = "0", GIT_CONFIG_COUNT = "3", GIT_CONFIG_KEY_0 = "url.https://github.com/b-urb/.insteadOf", GIT_CONFIG_VALUE_0 = "git@github.com:b-urb/", GIT_CONFIG_KEY_1 = "credential.https://github.com.helper", GIT_CONFIG_VALUE_1 = "", GIT_CONFIG_KEY_2 = "credential.https://github.com.helper", GIT_CONFIG_VALUE_2 = '!f() { test "$1" = get && test -n "${GH_TOKEN:-}" && printf "username=x-access-token\npassword=%s\n" "$GH_TOKEN"; }; f' }

[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp", "--headless"]

[mcp_servers.next-devtools]
command = "npx"
args = ["-y", "next-devtools-mcp@latest"]

[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
http_headers.Authorization = "Bearer {{ (bitwarden "item" "github-pat").login.password }}"
http_headers.X-MCP-Toolsets = "all"

[mcp_servers.pulumi]
url = "https://mcp.ai.pulumi.com/mcp"

[mcp_servers.storybook]
transport = "http"
url = "http://localhost:6006/mcp"

[mcp_servers.directus]
url = "https://cms.burbn.de/mcp/"
http_headers.Authorization = "Bearer {{ (bitwarden "item" "directus-token").login.password }}"
http_headers.X-MCP-Toolsets = "all"

[mcp_servers.kubernetes-readonly]
command = "npx"
args = ["mcp-server-kubernetes"]

[mcp_servers.kubernetes-readonly.env]
ALLOW_ONLY_NON_DESTRUCTIVE_TOOLS = "true"
KUBECONFIG = "{{ .chezmoi.homeDir }}/.kube/homelab-view.yaml"
